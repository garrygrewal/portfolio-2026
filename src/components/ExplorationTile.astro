---
import type { ExplorationProject } from '../data/explorations';

interface Props {
  project: ExplorationProject;
  mode?: 'scatter' | 'grid';
  index?: number;
}

const { project, mode = 'grid', index = 0 } = Astro.props;
const href = `/explorations/${project.slug}`;
const isStatic = project.static === true;
const tileClass = `exploration-tile exploration-tile--${mode} exploration-tile--${project.size}${isStatic ? ' exploration-tile--static' : ''}`;
const tileAttrs = {
  class: tileClass,
  'aria-label': project.title,
  'data-exploration-tile': mode === 'scatter' ? '' : undefined,
  'data-size': project.size,
  'data-index': index,
  style: `--tile-accent: ${project.accent};`,
};
---

{isStatic ? (
  <div {...tileAttrs}>
    <span class="exploration-tile-media" aria-hidden="true">
      {project.heroImageSrc ? (
        <img src={project.heroImageSrc} alt="" class="exploration-tile-image" loading={mode === 'scatter' ? 'eager' : 'lazy'} />
      ) : null}
    </span>
  </div>
) : (
  <a href={href} {...tileAttrs}>
    <span class="exploration-tile-media" aria-hidden="true">
      {project.heroVideo ? (
        <video class="exploration-tile-image" autoplay muted loop playsinline preload={mode === 'scatter' ? 'auto' : 'metadata'}>
          {project.heroVideo.webm && <source src={project.heroVideo.webm} type="video/webm" />}
          {project.heroVideo.mp4 && <source src={project.heroVideo.mp4} type="video/mp4" />}
        </video>
      ) : project.heroImageSrc ? (
        <img src={project.heroImageSrc} alt="" class="exploration-tile-image" loading={mode === 'scatter' ? 'eager' : 'lazy'} />
      ) : null}
    </span>
  </a>
)}

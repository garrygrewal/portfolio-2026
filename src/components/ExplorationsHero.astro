---
import ExplorationTile from './ExplorationTile.astro';
import type { ExplorationProject } from '../data/explorations';

interface Props {
  projects: ExplorationProject[];
}

const { projects } = Astro.props;
---

<section class="explorations-hero" data-explorations-hero aria-label="Scrollable exploration tiles">
  <div class="explorations-hero-stage">
    <div class="explorations-tile-layer" aria-label="Exploration projects">
      {projects.slice(0, 9).map((project, index) => (
        <ExplorationTile project={project} mode="scatter" index={index} />
      ))}
    </div>

    <div class="explorations-copy">
      <h1 class="explorations-title">
        A collection of half-baked (some fully-baked) projects that I've explored over the years.
      </h1>
    </div>

    <button class="explorations-scroll-cue" type="button" data-explorations-scroll-cue aria-label="Show next exploration tile">
      <span class="explorations-scroll-cue-arrow" aria-hidden="true"></span>
    </button>
  </div>
</section>

<script is:inline>
  (function() {
    var hero = document.querySelector('[data-explorations-hero]');
    if (!hero) return;

    var tiles = Array.prototype.slice.call(hero.querySelectorAll('[data-exploration-tile]'));
    if (!tiles.length) return;

    var scrollCue = hero.querySelector('[data-explorations-scroll-cue]');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    var desktopZones = [
      { x: 12, y: 18 },
      { x: 82, y: 18 },
      { x: 18, y: 74 },
      { x: 84, y: 68 },
      { x: 38, y: 16 },
      { x: 64, y: 78 },
      { x: 14, y: 46 },
      { x: 88, y: 44 },
      { x: 50, y: 86 }
    ];

    var mobileZones = [
      { x: 20, y: 14 },
      { x: 78, y: 16 },
      { x: 18, y: 76 },
      { x: 82, y: 72 },
      { x: 34, y: 34 },
      { x: 66, y: 38 },
      { x: 28, y: 90 },
      { x: 72, y: 88 },
      { x: 50, y: 12 }
    ];

    var shuffle = function(items) {
      var copy = items.slice();
      for (var i = copy.length - 1; i > 0; i -= 1) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = copy[i];
        copy[i] = copy[j];
        copy[j] = tmp;
      }
      return copy;
    };

    var clamp = function(value, min, max) {
      return Math.min(Math.max(value, min), max);
    };

    var tileOrder = shuffle(tiles).slice(0, 9);
    var visibleCount = 3;
    var maxStart = Math.max(tileOrder.length - visibleCount, 0);
    var currentMode = null;
    var currentPosition = 0;
    var targetPosition = 0;
    var animationFrame = null;
    var wheelLocked = false;
    var touchStartY = 0;
    var introComplete = false;
    var cueReady = false;
    var cueDismissed = false;

    var updateCue = function() {
      if (!scrollCue) return;

      var isAtStart = Math.round(targetPosition) === 0 && Math.abs(currentPosition) < 0.05;
      var isAtEnd = Math.round(targetPosition) >= maxStart && Math.abs(currentPosition - maxStart) < 0.05;

      if (isAtEnd) cueDismissed = true;
      if (isAtStart) cueDismissed = false;

      scrollCue.classList.toggle('is-visible', introComplete && cueReady && !cueDismissed);
    };

    var placeBatches = function(force) {
      var isMobile = window.innerWidth < 768;
      if (!force && currentMode === isMobile) return;

      currentMode = isMobile;

      var baseZones = isMobile ? mobileZones : desktopZones;
      var jitter = reducedMotion.matches ? 0 : isMobile ? 4 : 7;

      var zones = reducedMotion.matches ? baseZones : shuffle(baseZones);

      tileOrder.forEach(function(tile, index) {
        var zone = zones[index % zones.length];
        var left = clamp(zone.x + (Math.random() * jitter * 2 - jitter), 8, 92);
        var top = clamp(zone.y + (Math.random() * jitter * 2 - jitter), 8, 92);
        var scale = reducedMotion.matches ? 1 : 0.94 + Math.random() * 0.16;
        var baseOpacity = 1;

        tile.style.left = left + '%';
        tile.style.top = top + '%';
        tile.style.setProperty('--tile-scale', scale.toFixed(2));
        tile.style.setProperty('--tile-base-opacity', baseOpacity.toString());
      });
    };

    var setTileState = function(tile, opacity, interactive) {
      var presenceScale = 0.97 + 0.03 * clamp(opacity, 0, 1);
      tile.style.setProperty('--tile-current-opacity', opacity.toString());
      tile.style.setProperty('--tile-presence-scale', presenceScale.toFixed(3));
      tile.style.pointerEvents = interactive ? 'auto' : 'none';
      tile.setAttribute('aria-hidden', interactive ? 'false' : 'true');
      tile.tabIndex = interactive ? 0 : -1;
    };

    var applyPosition = function(position) {
      var startIndex = Math.min(Math.floor(position), maxStart);
      var progress = startIndex === maxStart ? 0 : position - startIndex;
      var outgoingTile = tileOrder[startIndex];
      var incomingTile = tileOrder[startIndex + visibleCount];

      tiles.forEach(function(tile) {
        setTileState(tile, 0, false);
      });

      for (var offset = 0; offset < visibleCount; offset += 1) {
        var tile = tileOrder[startIndex + offset];
        if (!tile) continue;
        var baseOpacity = parseFloat(tile.style.getPropertyValue('--tile-base-opacity')) || 0.3;
        setTileState(tile, baseOpacity, true);
      }

      if (outgoingTile && incomingTile && progress > 0) {
        var outgoingBaseOpacity = parseFloat(outgoingTile.style.getPropertyValue('--tile-base-opacity')) || 0.3;
        var incomingBaseOpacity = parseFloat(incomingTile.style.getPropertyValue('--tile-base-opacity')) || 0.3;
        var outgoingOpacity = outgoingBaseOpacity * (1 - progress);
        var incomingOpacity = incomingBaseOpacity * progress;

        setTileState(outgoingTile, clamp(outgoingOpacity, 0, outgoingBaseOpacity), outgoingOpacity > 0.08);
        setTileState(incomingTile, clamp(incomingOpacity, 0, incomingBaseOpacity), incomingOpacity > 0.08);
      }
    };

    var animateTo = function(nextPosition) {
      targetPosition = clamp(nextPosition, 0, maxStart);
      if (reducedMotion.matches) {
        currentPosition = targetPosition;
        applyPosition(currentPosition);
        return;
      }

      if (animationFrame !== null) return;

      var tick = function() {
        var distance = targetPosition - currentPosition;
        if (Math.abs(distance) < 0.01) {
          currentPosition = targetPosition;
          animationFrame = null;
          applyPosition(currentPosition);
          updateCue();
          return;
        }

        currentPosition += distance * 0.14;
        applyPosition(currentPosition);
        updateCue();
        animationFrame = window.requestAnimationFrame(tick);
      };

      animationFrame = window.requestAnimationFrame(tick);
    };

    var moveTiles = function(direction) {
      if (!introComplete) return;
      if (direction === 0) return;
      animateTo(Math.round(targetPosition) + direction);
      updateCue();
    };

    var handleWheel = function(event) {
      event.preventDefault();
      if (Math.abs(event.deltaY) < 8 || wheelLocked) return;

      wheelLocked = true;
      moveTiles(event.deltaY > 0 ? 1 : -1);
      window.setTimeout(function() {
        wheelLocked = false;
      }, 520);
    };

    var handleKeydown = function(event) {
      var tagName = event.target && event.target.tagName;
      if (tagName === 'INPUT' || tagName === 'TEXTAREA' || tagName === 'SELECT') return;

      if (event.key === 'ArrowDown' || event.key === 'PageDown' || event.key === ' ') {
        event.preventDefault();
        moveTiles(1);
      } else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
        event.preventDefault();
        moveTiles(-1);
      }
    };

    var handleTouchStart = function(event) {
      if (!event.touches || event.touches.length === 0) return;
      touchStartY = event.touches[0].clientY;
    };

    var handleTouchEnd = function(event) {
      if (!event.changedTouches || event.changedTouches.length === 0) return;
      var delta = touchStartY - event.changedTouches[0].clientY;
      if (Math.abs(delta) < 32) return;
      moveTiles(delta > 0 ? 1 : -1);
    };

    placeBatches(true);
    tiles.forEach(function(tile) {
      setTileState(tile, 0, false);
    });

    var startTiles = function() {
      introComplete = true;
      hero.classList.add('is-intro-complete');
      applyPosition(currentPosition);

      if (reducedMotion.matches) {
        cueReady = true;
        updateCue();
      } else {
        window.setTimeout(function() {
          cueReady = true;
          updateCue();
        }, 850);
      }
    };

    if (reducedMotion.matches) {
      startTiles();
    } else {
      window.setTimeout(startTiles, 1200);
    }

    hero.addEventListener('wheel', handleWheel, { passive: false });
    hero.addEventListener('touchstart', handleTouchStart, { passive: true });
    hero.addEventListener('touchend', handleTouchEnd, { passive: true });
    if (scrollCue) {
      scrollCue.addEventListener('click', function() {
        moveTiles(1);
      });
    }
    window.addEventListener('keydown', handleKeydown);
    window.addEventListener('resize', function() {
      currentMode = null;
      placeBatches(true);
      applyPosition(currentPosition);
      updateCue();
    });

    if (reducedMotion.addEventListener) {
      reducedMotion.addEventListener('change', function() {
        currentMode = null;
        placeBatches(true);
        animateTo(Math.round(targetPosition));
      });
    }
  })();
</script>

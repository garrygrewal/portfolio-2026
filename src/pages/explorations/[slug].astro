---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Figure from '../../components/Figure.astro';
import { explorationProjects, type ExplorationProject } from '../../data/explorations';

export const prerender = true;

export function getStaticPaths() {
  // These slugs have their own hand-authored pages in this directory,
  // so they're excluded here to avoid generating duplicate routes for them.
  const handAuthored = ['click-here-to-get-candy', 'patagonia-worn-wear', 'youme', 'airduino-hockey'];
  return explorationProjects
    .filter((project) => !handAuthored.includes(project.slug))
    .map((project) => ({
      params: { slug: project.slug },
      props: { project }
    }));
}

interface Props {
  project: ExplorationProject;
}

const { project } = Astro.props;

const metadata = [
  { label: 'Platform', values: [project.platform] },
  { label: 'Roles', values: [project.roles] }
];
---

<CaseStudyLayout
  title={project.title}
  description={project.description}
  heroImageSrc={project.heroImageSrc}
  heroVideo={project.heroVideo}
  heroImageAlt={project.heroImageAlt}
  metadata={metadata}
>
  <div class="content-block-text">
    {project.body?.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="content-block-offset-right">
    <Figure
      src={project.heroImageSrc}
      videoSrc={project.heroVideo?.webm ?? project.heroVideo?.mp4}
      alt={project.heroImageAlt}
      caption={project.caption}
    />
  </div>

  <div class="content-block-text">
    <p>This is a placeholder exploration page. The structure is ready for final writing, real process images, and more detailed notes once this project becomes something worth properly documenting.</p>
  </div>
</CaseStudyLayout>
